      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2025-09-03"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({parent:{type:\"data_source_id\",data_source_id:\"0edc4b55-7612-417d-9e05-37f79b70e555\"},properties:(()=>{const d=$(\"Validate signup\").first().json;return {Email:{title:[{text:{content:d.email}}]},\"First Name\":{rich_text:[{text:{content:d.firstName}}]},\"Marketing Consent\":{checkbox:d.marketingConsent},\"Source\":{rich_text:[{text:{content:\"BSS native free-guide form\"}}]},\"Guide\":{rich_text:[{text:{content:\"Your First AI Business Workflow\"}}]},\"Submitted At\":{date:{start:d.submittedAt}},\"Delivery Status\":{select:{name:\"Pending\"}}};})()}) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
