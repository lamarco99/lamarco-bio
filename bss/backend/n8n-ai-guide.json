              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f602502c-77e8-4f02-bc78-abebfd9fc598",
      "name": "Create signup",
      "type": "n8n-nodes-base.httpRequest",
