              "name": "Notion-Version",
              "value": "2025-09-03"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({properties:{\"Marketing Consent\":{checkbox:$json.results[0].properties[\"Marketing Consent\"].checkbox || $(\"Validate signup\").first().json.marketingConsent},\"Delivery Status\":{select:{name:\"Pending\"}}}}) }}",
        "options": {
          "timeout": 15000
        }
