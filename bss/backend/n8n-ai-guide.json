  "nodes": [
    {
      "id": "c5cc34f1-f33e-444e-ac69-64767b884d0f",
      "name": "Signup webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bss-ai-guide",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://lamarco99.github.io",
          "ignoreBots": true
        }
      }
    },
    {
      "id": "a0c21175-5c84-493c-aa20-58d7e43747e3",
      "name": "Validate signup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const raw=$json.body||{};const origin=$json.headers?.origin;const email=String(raw.email||'').trim().toLowerCase();const firstName=String(raw.firstName||'').trim();const requestId=String(raw.requestId||'');\nconst valid=origin==='https://lamarco99.github.io'&&!raw.website&&email.length<=254&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)&&firstName.length<=80&&/^[0-9a-f-]{36}$/i.test(requestId);\nreturn [{json:{valid,email,firstName,requestId,marketingConsent:raw.marketingConsent==='true',submittedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "2c40dccd-ae08-48eb-b352-c6178d40e52a",
      "name": "Valid request",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "77c0d823-a7ee-4899-a150-aa197a97fd31",
      "name": "Find signup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/data_sources/0edc4b55-7612-417d-9e05-37f79b70e555/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2025-09-03"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({filter:{property:\"Email\",title:{equals:$(\"Validate signup\").first().json.email}},page_size:1}) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "d8605733-6f80-4767-a05e-6d140c8b902d",
